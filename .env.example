# Session token (c-token). Get one with: python -m sinama qr-login
SINAMA_TOKEN=
# Where the session is saved (default ~/.sinama/session.json)
SINAMA_SESSION_FILE=
# Skip discovery and use this host, e.g. https://world.hana-api.com/api/v2
SINAMA_HOST=
# Defaults for Client.login() (password login also needs a reCAPTCHA token)
SITE_30NAMA_EMAIL=
SITE_30NAMA_PASSWORD=
